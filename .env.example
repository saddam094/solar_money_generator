VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-anon-key

# Optional: local development overrides (create .env.local and copy values from this file)
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are required for Supabase to work.

# Example:
# VITE_SUPABASE_URL=https://abcd1234.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Notes:
# - After creating `.env.local` (or filling these values), restart the dev server:
#     npm run dev
# - Never commit real secret keys to source control. Use environment variables in CI/deploy.